&CONTROL
   calculation      = 'scf'
   tstress          = .true.
   tprnfor          = .true.
   pseudo_dir       = 'tests/data'
/
&SYSTEM
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'mv'
   nspin            = 1
   ntyp             = 1
   nat              = 2
   ibrav            = 0
/
&ELECTRONS
   electron_maxstep = 800
   conv_thr         = 1e-06
   mixing_mode      = 'local-TF'
   mixing_beta      = 0.2
   diagonalization  = 'david'
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
Si 28.085 Si.pbe.usp

K_POINTS automatic
1 1 1  0 0 0

CELL_PARAMETERS angstrom
5.43100000000000 0.00000000000000 0.00000000000000
0.00000000000000 5.43100000000000 0.00000000000000
0.00000000000000 0.00000000000000 5.43100000000000

ATOMIC_POSITIONS angstrom
Si 0.0000000000 0.0000000000 0.0000000000  
Si 1.3577500000 1.3577500000 1.3577500000  

